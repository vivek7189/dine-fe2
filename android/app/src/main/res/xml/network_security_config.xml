<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      On-prem OFFLINE mode: terminals talk to a local server over the LAN at an
      arbitrary private IP (e.g. http://192.168.1.50:3003) and ws:// for real-time.
      Android 9+ blocks cleartext by default, so permit it at the base config.
      HTTPS is still used wherever the URL is https:// (cloud API), so this only
      enables the on-prem LAN case — appropriate for a POS on a controlled network.
    -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
